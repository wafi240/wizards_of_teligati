<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/deep_navy"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💼  Alumni Login"
            android:textColor="@color/accent_purple"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome back to Wizards of Teligati"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="32dp"/>

        <EditText
            android:id="@+id/etAlumniEmail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/card_dark"
            android:hint="Email Address"
            android:inputType="textEmailAddress"
            android:padding="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etAlumniPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/card_dark"
            android:hint="Password"
            android:inputType="textPassword"
            android:padding="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnLoginAlumni"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="@color/accent_purple"
            android:text="Log In"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnAlumniDemo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="@color/indigo_dark"
            android:text="⚡  Try Demo Account"
            android:textColor="@color/accent_purple"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/tvAlumniForgotPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Forgot Password?"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:padding="6dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvGoToAlumniRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Don't have an account?  Register here"
            android:textColor="@color/mystic_cyan"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
