<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/deep_navy"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏛️  Create Faculty Account"
            android:textColor="@color/emerald_green"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connect with student researchers at KUET"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="28dp"/>

        <EditText
            android:id="@+id/etRegFacultyName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/card_dark"
            android:hint="Full Name"
            android:padding="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etRegFacultyDept"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/card_dark"
            android:hint="Department (e.g. CSE)"
            android:padding="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etRegFacultyDesignation"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/card_dark"
            android:hint="Designation (e.g. Professor)"
            android:padding="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etRegFacultyLab"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/card_dark"
            android:hint="Research Lab (optional)"
            android:padding="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etRegFacultyResearch"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/card_dark"
            android:hint="Research Areas (optional)"
            android:padding="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etRegFacultyEmail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/card_dark"
            android:hint="Institutional Email"
            android:inputType="textEmailAddress"
            android:padding="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnCreateFacultyAccount"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="@color/emerald_green"
            android:text="Create Account"
            android:textColor="@color/deep_navy"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:id="@+id/tvBackToFacultyLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"
            android:text="Already have an account?  Log In"
            android:textColor="@color/mystic_cyan"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
