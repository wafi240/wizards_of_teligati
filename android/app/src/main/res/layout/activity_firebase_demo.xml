<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/deep_navy">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_dark">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarFirebase"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Firebase Course Demo"
            app:titleTextColor="@color/text_primary"
            app:subtitle="KUET Project Requirements"
            app:subtitleTextColor="@color/mystic_cyan"
            app:navigationIcon="@drawable/ic_nav_home" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Banner / Architecture Disclaimer -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/card_dark"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📌 Course Demonstration Architecture"
                        android:textColor="@color/accent_gold"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="• Primary App Backend: Spring Boot REST API + Room DB\n• Secondary Firebase Services: Course requirement demo for Auth, Realtime Database, Firestore, and Storage."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 1. FIREBASE AUTHENTICATION SECTION -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/card_dark"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1️⃣ Firebase Authentication"
                        android:textColor="@color/mystic_cyan"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="12dp"
                        android:text="Demonstrate email/password registration, login, and auth state."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etAuthEmail"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@color/indigo_dark"
                        android:hint="Email (e.g. student@kuet.ac.bd)"
                        android:textColorHint="@color/text_secondary"
                        android:textColor="@color/text_primary"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="14sp"
                        android:inputType="textEmailAddress"
                        android:text="demo.student@kuet.ac.bd"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/etAuthPassword"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@color/indigo_dark"
                        android:hint="Password (min 6 characters)"
                        android:textColorHint="@color/text_secondary"
                        android:textColor="@color/text_primary"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="14sp"
                        android:inputType="textPassword"
                        android:text="demo123456"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnAuthRegister"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/indigo_dark"
                            android:text="Register"
                            android:textColor="@color/mystic_cyan"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/btnAuthLogin"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/mystic_cyan"
                            android:text="Log In"
                            android:textColor="@color/deep_navy"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnAuthLogout"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/slate_blue"
                            android:text="Log Out"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAuthStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@color/indigo_dark"
                        android:padding="8dp"
                        android:text="Auth Status: Not logged in"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:fontFamily="monospace" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 2. REALTIME DATABASE SECTION -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/card_dark"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2️⃣ Firebase Realtime Database"
                        android:textColor="@color/accent_purple"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="12dp"
                        android:text="Demonstrate live status ping and real-time synchronization listener."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etRtdbStatus"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@color/indigo_dark"
                        android:hint="Status ping (e.g. KUET Library open till 9 PM)"
                        android:textColorHint="@color/text_secondary"
                        android:textColor="@color/text_primary"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="14sp"
                        android:text="KUET Central Library is open till 9 PM"
                        android:layout_marginBottom="10dp" />

                    <Button
                        android:id="@+id/btnRtdbUpdate"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:backgroundTint="@color/accent_purple"
                        android:text="Push Status Update to RTDB"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="⚡ Live Listener Value (/demo_activity_status):"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvRtdbLiveValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@color/indigo_dark"
                        android:padding="8dp"
                        android:text="Waiting for real-time value..."
                        android:textColor="@color/accent_gold"
                        android:textSize="12sp"
                        android:fontFamily="monospace" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 3. CLOUD FIRESTORE SECTION -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/card_dark"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3️⃣ Firebase Cloud Firestore"
                        android:textColor="@color/emerald_green"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="12dp"
                        android:text="Structured document storage for announcements and records."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etFirestoreTitle"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@color/indigo_dark"
                        android:hint="Announcement Title"
                        android:textColorHint="@color/text_secondary"
                        android:textColor="@color/text_primary"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="14sp"
                        android:text="Robotics Club Annual Workshop"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/etFirestoreDesc"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@color/indigo_dark"
                        android:hint="Announcement Details"
                        android:textColorHint="@color/text_secondary"
                        android:textColor="@color/text_primary"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="14sp"
                        android:text="Hands-on ROS2 &amp; IoT sessions. Venue: CSE Seminar Room"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnFirestoreAdd"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/emerald_green"
                            android:text="Add to Firestore"
                            android:textColor="@color/deep_navy"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnFirestoreFetch"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/indigo_dark"
                            android:text="Fetch Records"
                            android:textColor="@color/emerald_green"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvFirestoreOutput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@color/indigo_dark"
                        android:padding="8dp"
                        android:maxLines="6"
                        android:scrollbars="vertical"
                        android:text="No Firestore documents loaded yet."
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:fontFamily="monospace" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 4. FIREBASE CLOUD STORAGE SECTION -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/card_dark"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4️⃣ Firebase Cloud Storage"
                        android:textColor="@color/accent_gold"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="12dp"
                        android:text="Demonstrate binary media / profile picture upload and retrieval."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:id="@+id/ivStorageAvatar"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:background="@color/indigo_dark"
                            android:padding="4dp"
                            android:scaleType="centerInside"
                            android:contentDescription="Demo Avatar"
                            android:src="@drawable/ic_nav_profile" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <Button
                                android:id="@+id/btnStorageUpload"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:backgroundTint="@color/accent_gold"
                                android:text="Upload Demo Avatar"
                                android:textColor="@color/deep_navy"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="6dp" />

                            <Button
                                android:id="@+id/btnStorageDownload"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:backgroundTint="@color/indigo_dark"
                                android:text="Download Avatar"
                                android:textColor="@color/accent_gold"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStorageStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/indigo_dark"
                        android:padding="8dp"
                        android:text="Storage Status: Ready to upload sample profile image"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:fontFamily="monospace" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 5. REAL-TIME ACTIVITY & DIAGNOSTIC LOG -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/card_dark"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="📋 Live Activity &amp; Diagnostic Log"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnClearLog"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:backgroundTint="@color/indigo_dark"
                            android:text="Clear"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvEventLog"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:background="#050B14"
                        android:padding="10dp"
                        android:scrollbars="vertical"
                        android:textColor="#38BDF8"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:text="[Ready] Firebase Demo initialized." />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
