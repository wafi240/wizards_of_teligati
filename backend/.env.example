# =============================================================================
# Wizards of Teligati Backend: Environment Configuration Template
# Copy this file to '.env' and populate with your local values.
# NEVER commit the actual '.env' file or production credentials to git.
# =============================================================================

# Application Server
SERVER_PORT=8080

# PostgreSQL Database Configuration
DB_NAME=teligati
DB_USERNAME=postgres
DB_PASSWORD=your_secure_database_password_here
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/teligati

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# JWT Security
JWT_SECRET=your_base64_encoded_256_bit_jwt_secret_key_here
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000
