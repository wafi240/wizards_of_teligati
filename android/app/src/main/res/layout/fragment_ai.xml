<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/deep_navy"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🪄 Teligati AI Career Advisor"
        android:textColor="@color/mystic_cyan"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Smart opportunity matching and security secret scanner."
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Quick suggestion buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/chipTuition"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:backgroundTint="@color/indigo_dark"
            android:text="Replace Tuitions"
            android:textColor="@color/mystic_cyan"
            android:textSize="10sp" />

        <Button
            android:id="@+id/chipResearch"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/indigo_dark"
            android:text="Research Papers"
            android:textColor="@color/mystic_cyan"
            android:textSize="10sp" />

        <Button
            android:id="@+id/chipSecret"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/card_dark"
            android:text="Secret Scan"
            android:textColor="@color/accent_gold"
            android:textSize="10sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollAiChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/tvAiChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_dark"
            android:padding="14dp"
            android:lineSpacingExtra="4dp"
            android:text="🪄 Teligati AI: Welcome! Ask me about Assistant work replacing tuitions, research papers with professors, or let me scan your code to prevent leaking API keys or credentials."
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etAiPrompt"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@color/card_dark"
            android:hint="Ask Teligati AI..."
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <ImageButton
            android:id="@+id/btnSendAi"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_send_button"
            android:contentDescription="Send"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_send" />
    </LinearLayout>
</LinearLayout>
