<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/deep_navy"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏢 Alumni Executive Portal"
            android:textColor="@color/mystic_cyan"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hire trusted KUET juniors, give referrals and mentor students."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Alumni Profile Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/card_dark"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvAlumniName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Engr. Tanvir Ahmed ✓ Verified Alumni"
                    android:textColor="@color/mystic_cyan"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAlumniMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Staff Engineer @ BMW Munich • CSE 2K12"
                    android:textColor="@color/accent_purple"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="📍 Munich, Germany • Mentor and Hiring Partner"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vouched by KUET Alumni Association (Global)"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnAlumniProfile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/indigo_dark"
                    android:text="View Public Alumni Profile"
                    android:textColor="@color/mystic_cyan" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Actions: Post Professional Jobs & Post Assistant Jobs with Money -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="📢 Post Opportunities"
            android:textColor="@color/mystic_cyan"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAlumniPostJob"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/accent_purple"
                android:text="+ Post Full-time Job"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnAlumniPostAssistantJob"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/emerald_green"
                android:text="+ Post Paid Assistant"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Reference and Suggestion Requests Inbox -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📬 Reference and Suggestion Requests"
                android:textColor="@color/mystic_cyan"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPendingRefBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 Pending"
                android:textColor="@color/accent_gold"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Requests from juniors seeking internal referrals and career advice."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAlumniReferenceRequests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:nestedScrollingEnabled="false" />

        <!-- Active Postings by Alumni -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="📋 Your Active Job Listings"
            android:textColor="@color/mystic_cyan"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAlumniMyJobs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:nestedScrollingEnabled="false" />

        <!-- Logout Button -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="@color/card_dark"
            android:text="Switch Role / Log Out"
            android:textColor="@color/text_secondary" />
    </LinearLayout>
</ScrollView>
