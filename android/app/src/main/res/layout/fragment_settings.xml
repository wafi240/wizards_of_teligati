<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/deep_navy"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚙️ Preferences &amp; Account Settings"
        android:textColor="@color/mystic_cyan"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Configure account security, notifications, and Teligati AI preferences."
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KUET Identity Verification"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Verified institutional email and roll on cryptographic registry."
                android:textColor="@color/emerald_green"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/slate_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Wizard Match Notifications"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Receive alerts when new jobs match your skills and CGPA."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/slate_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Demo Wallet &amp; Escrow Simulation"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="DEMO WALLET — NO REAL MONEY INVOLVED. Pure educational simulation with virtual demo credits."
                android:textColor="@color/accent_gold"
                android:textSize="12sp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnFirebaseDemoSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/accent_gold"
        android:text="🔥 Firebase Course Requirements Demo"
        android:textColor="@color/deep_navy"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnBroadcastDemoSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/slate_blue"
        android:text="📡 Broadcast Receiver Demo"
        android:textColor="@color/white" />

    <Button
        android:id="@+id/btnStudyServiceSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/indigo_dark"
        android:text="⏱️ Study Session Foreground Service"
        android:textColor="@color/accent_gold" />

    <Button
        android:id="@+id/btnVisitKuetWebsite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/indigo_dark"
        android:text="🌐 Visit KUET Portal (Implicit Intent: ACTION_VIEW)"
        android:textColor="@color/mystic_cyan" />

    <Button
        android:id="@+id/btnServerConfigSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/indigo_dark"
        android:text="🌐 Backend Server Connection"
        android:textColor="@color/mystic_cyan" />

    <Button
        android:id="@+id/btnLogoutSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/card_dark"
        android:text="🚪 Sign Out / Logout"
        android:textColor="@color/white"
        android:textStyle="bold" />

</LinearLayout>
