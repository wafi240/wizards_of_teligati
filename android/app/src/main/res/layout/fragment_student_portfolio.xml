<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/deep_navy"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎓 Personal Tech Portfolio"
            android:textColor="@color/mystic_cyan"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your verified academic, skill, and project profile for Alumni &amp; Faculty."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Profile Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/card_dark"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvPortfolioName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Samun Sadab Wafi"
                    android:textColor="@color/mystic_cyan"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPortfolioRoll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="KUET Roll 2307003 • CSE 2K23 • CGPA 3.84"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPortfolioSpecialization"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Specialization: Distributed Systems, Embedded AI &amp; Cloud"
                    android:textColor="@color/accent_purple"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvPortfolioSkills"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Skills: Java, Kotlin, Python, Spring Boot, PyTorch, Docker, Git, ROS"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvPortfolioProjects"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Projects: Autonomous Campus Rover (ROS), Wizards of Teligati (Android/Spring)"
                    android:textColor="@color/emerald_green"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvPortfolioLinks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Links: github.com/kuet-wizards • linkedin.com/in/kuet-student"
                    android:textColor="@color/accent_gold"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnEditPortfolio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/indigo_dark"
                    android:text="✏️ Edit &amp; Update Portfolio"
                    android:textColor="@color/mystic_cyan" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
