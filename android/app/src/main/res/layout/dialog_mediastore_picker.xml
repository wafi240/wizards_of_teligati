<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_dark"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🖼️ MediaStore Content Provider"
        android:textColor="@color/mystic_cyan"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="12dp"
        android:text="Select a device photo from MediaStore to preview as profile avatar."
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Progress / Empty indicator -->
    <LinearLayout
        android:id="@+id/layoutEmptyMedia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No images found in device MediaStore."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnGenerateSampleImage"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/indigo_dark"
            android:text="+ Insert Sample Image to MediaStore"
            android:textColor="@color/mystic_cyan"
            android:textSize="12sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMediaStoreImages"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:scrollbars="vertical" />

    <Button
        android:id="@+id/btnCloseMediaPicker"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/indigo_dark"
        android:text="Close"
        android:textColor="@color/text_primary" />
</LinearLayout>
